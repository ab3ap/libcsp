    #
    #   2 .   S C F ,   F S M   a n d   T S M
    #

    if res2:
        print('\nCSP Estimators: The Frequency-Smoothing Method')
        print('https://cyclostationary.blog/2015/11/20/csp-estimators-the-frequency-smoothing-method/')
