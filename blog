    title = ('Non-conjugate %s %s, 500 Largest'
        % (tsmType, (' SC' if sc else 'SCF')))
    freq = ncQuads.transpose()[0].real
    alpha = ncQuads.transpose()[1].real
    g = np.abs(ncQuads.transpose()[3])

